# Variables públicas (SSR + cliente) — clave "anon", solo lectura por RLS.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxxxxx

# Variable SOLO de servidor — clave "service role". Se configura en
# Netlify (Site configuration > Environment variables), NUNCA en este
# archivo si el repo es público, y nunca se usa desde el navegador.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx
