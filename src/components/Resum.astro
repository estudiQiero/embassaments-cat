---
import GaugeGlobal from './GaugeGlobal.astro';
const { resum, comparatives } = Astro.props;
---
<section class="resum">
  <div class="capsula gran">
    <p>Percentatge mitjà d'ompliment</p>
    <GaugeGlobal percentatge={resum.percentatgeMitja} />
  </div>

  <div class="capsules-dretes">
    <div class="capsula capsula-volum">
      <p>Volum total embassat avui dia {resum.dataMesRecent ?? '—'}</p>
      <h3 class="mono">{resum.volumTotal.toFixed(1)} hm³</h3>
      <p class="sub">de {resum.capacitatMaxima} hm³ de capacitat</p>

      <hr class="separador" />

      <button type="button" id="btn-mostrar-dia" class="btn-mostrar-dia">Consulta un altre dia…</button>
      <input
        type="date"
        id="input-data-historica"
        class="input-data-historica"
        max={resum.dataMesRecent ?? undefined}
        min="2000-01-01"
        data-volum-avui={resum.volumTotal}
        data-percentatge-avui={resum.percentatgeMitja ?? ''}
        hidden
      />

      <div class="fila-historica" id="fila-historica" hidden>
        <p id="label-historic">Volum total embassat el dia —</p>
        <h3 class="mono" id="valor-historic">— hm³</h3>
        <p class="diferencia-historica" id="diferencia-historica" hidden>
          <span class="fletxa" id="fletxa-historica"></span>
          <span class="mono" id="text-diferencia"></span>
        </p>
      </div>
    </div>

    <div class="comparatives" id="comparatives-relatives">
      {comparatives.map((c) => (
        <div class="comp">
          <span class="etiqueta">{c.label}</span>
          {c.disponible ? (
            <span class:list={['dif', 'mono', c.diferencia >= 0 ? 'puja' : 'baixa']}>
              {c.diferencia >= 0 ? '+' : ''}{c.diferencia.toFixed(1)} hm³ | {c.percentatgeMitja.toFixed(1)}%
            </span>
          ) : (
            <span class="dif mono sense-dada">sense dada</span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { fetchVolumEnData } from '../lib/embassaments.js';

  const btn = document.getElementById('btn-mostrar-dia');
  const input = document.getElementById('input-data-historica');
  const comparatives = document.getElementById('comparatives-relatives');
  const filaHistorica = document.getElementById('fila-historica');
  const labelHistoric = document.getElementById('label-historic');
  const valorHistoric = document.getElementById('valor-historic');
  const diferenciaHistorica = document.getElementById('diferencia-historica');
  const fletxaHistorica = document.getElementById('fletxa-historica');
  const textDiferencia = document.getElementById('text-diferencia');

  const avuiISO = input?.max || null;
  const volumAvui = parseFloat(input?.dataset.volumAvui ?? 'NaN');
  const percentatgeAvui = parseFloat(input?.dataset.percentatgeAvui ?? 'NaN');

  function fletxaSVG(positiva) {
    const d = positiva ? 'M4,10 L8,6 L12,10' : 'M4,6 L8,10 L12,6';
    return `<svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="${d}" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
  }

  btn?.addEventListener('click', () => {
    input.hidden = false;
    input.focus();
    if (typeof input.showPicker === 'function') input.showPicker();
  });

  input?.addEventListener('change', async () => {
    const dataSeleccionada = input.value;

    if (!dataSeleccionada || dataSeleccionada === avuiISO) {
      filaHistorica.hidden = true;
      comparatives.hidden = false;
      return;
    }

    comparatives.hidden = true;
    filaHistorica.hidden = false;
    diferenciaHistorica.hidden = true;
    labelHistoric.textContent = `Volum total embassat el dia ${dataSeleccionada}`;
    valorHistoric.textContent = 'Carregant…';

    try {
      const dades = await fetchVolumEnData(dataSeleccionada);
      if (!dades) {
        valorHistoric.textContent = 'Sense dades';
        return;
      }
      valorHistoric.textContent = `${dades.volumTotal.toFixed(1)} hm³`;

      const diffVol = volumAvui - dades.volumTotal;
      const diffPct = percentatgeAvui - dades.percentatgeMitja;
      const positiva = diffVol >= 0;

      diferenciaHistorica.className = `diferencia-historica ${positiva ? 'positiu' : 'negatiu'}`;
      fletxaHistorica.innerHTML = fletxaSVG(positiva);
      textDiferencia.textContent = `${positiva ? '+' : ''}${diffVol.toFixed(1)} hm³ | ${diffPct >= 0 ? '+' : ''}${diffPct.toFixed(1)}%`;
      diferenciaHistorica.hidden = false;
    } catch {
      valorHistoric.textContent = 'Error carregant les dades';
    }
  });
</script>

<style>
  .resum {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .capsula {
    background: var(--surface-card);
    padding: 24px;
  }
  .capsula.gran {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
  }
  .capsula p { margin: 0 0 6px; font-size: 0.78rem; color: var(--ink-soft); }
  .capsula h3 { font-size: 1.5rem; }
  .sub { margin-top: 4px !important; font-size: 0.72rem !important; }

  .capsules-dretes {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .capsula-volum {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .separador {
    width: 100%;
    max-width: 260px;
    border: none;
    border-top: 1px solid var(--line);
    margin: 16px 0;
  }
  .btn-mostrar-dia {
    font: inherit;
    font-size: 0.78rem;
    color: var(--water-deep);
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 6px 12px;
    cursor: pointer;
  }
  .btn-mostrar-dia:hover { background: var(--surface-dim); }
  .input-data-historica {
    font: inherit;
    font-size: 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 5px 10px;
    background: var(--surface-card);
    color: var(--ink);
    margin-top: 10px;
  }

  .fila-historica {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .fila-historica[hidden] { display: none; }
  .diferencia-historica {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 6px 0 0 !important;
    font-size: 0.85rem;
  }
  .diferencia-historica.positiu { color: var(--positiu); }
  .diferencia-historica.negatiu { color: var(--negatiu); }
  .diferencia-historica[hidden] { display: none; }
  .fletxa { display: inline-flex; }

  .comparatives {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--surface-dim);
  }
  .comparatives[hidden] { display: none; }
  .comp {
    padding: 14px 20px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .etiqueta { font-size: 0.72rem; color: var(--ink-soft); }
  .dif { font-size: 0.95rem; }
  .puja { color: var(--water-deep); }
  .baixa { color: var(--alert); }
  .sense-dada { color: var(--ink-soft); font-style: italic; }

  @media (max-width: 720px) {
    .resum { grid-template-columns: 1fr; }
    .capsules-dretes { grid-template-columns: 1fr; }
    .comparatives { grid-template-columns: repeat(2, 1fr); }
  }
</style>
