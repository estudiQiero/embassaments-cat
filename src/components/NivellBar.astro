---
// Corte transversal de un embalse: el agua sube desde abajo hasta el
// nivel actual, con una línea superior ligeramente ondulada (evoca la
// superficie del agua) y marcas de cota cada 25%. El color pasa de
// agua-pálida a agua-profunda según el nivel; solo entra en rojo/ocre
// de alerta por debajo del 20%, en vez del arcoíris fijo del proyecto
// anterior. El % va debajo, no superpuesto, para que sea legible a
// tamaño grande dentro de la columna de la tarjeta.
interface Props {
  percentatge: number | null;
  slug?: string;
}
const { percentatge, slug } = Astro.props;
const pct = percentatge === null ? 0 : Math.max(0, Math.min(100, percentatge));

const color = pct < 20 ? 'var(--alert)' : pct < 45 ? 'var(--water-mid)' : 'var(--water-deep)';
const alturaAigua = 84 * (pct / 100);
const yAigua = 90 - alturaAigua;
const gradId = `aigua-grad-${Math.random().toString(36).slice(2, 9)}`;

// Cantonades inferiors arrodonides, compartides pel contenidor i per
// la làmina d'aigua (perquè l'aigua no sobresurti del got pel cantó).
const r = 6;

// Onatge molt subtil: la mateixa corba de la superfície oscil·lant
// entre dues fases (cresta amunt / avall) per suggerir aigua viva,
// sense que es noti com una animació brusca. Els cantons de baix
// segueixen el mateix arrodoniment que el contenidor.
const onadaA = `M1,${yAigua} Q30,${yAigua - 3} 60,${yAigua} T119,${yAigua} L119,${92 - r} Q119,92 ${119 - r},92 L${1 + r},92 Q1,92 1,${92 - r} Z`;
const onadaB = `M1,${yAigua} Q30,${yAigua + 3} 60,${yAigua} T119,${yAigua} L119,${92 - r} Q119,92 ${119 - r},92 L${1 + r},92 Q1,92 1,${92 - r} Z`;

// Contorn amb cantonades inferiors lleugerament arrodonides (la part
// de dalt queda oberta, com abans, per suggerir la superfície).
const contenidor = `M1,4 L1,${92 - r} Q1,92 ${1 + r},92 L${119 - r},92 Q119,92 119,${92 - r} L119,4`;

// El "tanc" es dibuixa en un sistema de coordenades local (0-120) que
// es desplaça dins d'un viewBox més ample, per deixar marge fora del
// contenidor: a l'esquerra per als percentatges de les marques de
// cota, i a la dreta per al percentatge de la comparativa històrica.
const desplaçament = 25;
---
<div class="nivell-bar" data-slug={slug} role="img" aria-label={percentatge === null ? 'Nivell no disponible' : `Nivell al ${pct.toFixed(1)}%`}>
  <svg viewBox={`0 0 ${120 + desplaçament + 34} 96`} preserveAspectRatio="none">
    <defs>
      <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color={color} stop-opacity="1" />
        <stop offset="100%" stop-color={color} stop-opacity="0.35" />
      </linearGradient>
    </defs>
    <g transform={`translate(${desplaçament} 0)`}>
      <!-- L'aigua va primer, per darrere del contorn i les marques de
           cota: així el got queda per davant del líquid, com un
           recipient real, en lloc de tapar-lo. -->
      {percentatge !== null && (
        <path fill={`url(#${gradId})`} d={onadaA}>
          <animate
            attributeName="d"
            dur="5s"
            repeatCount="indefinite"
            calcMode="spline"
            keyTimes="0; 0.5; 1"
            keySplines="0.45 0 0.55 1; 0.45 0 0.55 1"
            values={`${onadaA}; ${onadaB}; ${onadaA}`}
          />
        </path>
      )}
      <path d={contenidor} fill="none" stroke="var(--line)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      {[25, 50, 75].map((marca) => (
        <>
          <line x1="1" x2="9" y1={90 - 84 * (marca / 100)} y2={90 - 84 * (marca / 100)} stroke="var(--line)" stroke-width="2.5" stroke-linecap="round" />
          <text x="-4" y={90 - 84 * (marca / 100) + 3} class="text-cota" text-anchor="end">{marca}%</text>
        </>
      ))}
      <g class="marcador-historic">
        <line x1="1" x2="119" y1="48" y2="48" class="linia-historica" />
        <text x="124" y="51" class="text-historic" text-anchor="start">—</text>
      </g>
    </g>
  </svg>
  <span class="valor mono" style={`color:${color}`}>
    {percentatge === null ? '—' : `${pct.toFixed(1)}%`}
  </span>
</div>

<style>
  .nivell-bar {
    width: 70%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  svg { width: 100%; height: auto; display: block; max-height: 190px; }
  .valor {
    font-size: 1.6rem;
    font-weight: 500;
  }
  .text-cota {
    fill: var(--water-deep);
    font-family: var(--font-body);
    font-size: 9px;
  }
  .marcador-historic {
    display: none;
  }
  .marcador-historic.visible {
    display: block;
  }
  .linia-historica {
    stroke: var(--negatiu);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 0.5 3.2;
  }
  .text-historic {
    fill: var(--negatiu);
    font-family: var(--font-body);
    font-size: 9px;
  }
</style>
