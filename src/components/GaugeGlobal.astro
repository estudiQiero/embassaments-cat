---
// Arco de 270° para el % medio de ocupación de las conques internes.
// Sustituye al número plano "2.4rem" de la versión anterior por un
// elemento realmente visual y grande, coherente con el resto de la
// estética "limnígrafo" de la web.
interface Props {
  percentatge: number | null;
}
const { percentatge } = Astro.props;
const pct = percentatge === null ? 0 : Math.max(0, Math.min(100, percentatge));
const color = pct < 20 ? 'var(--alert)' : pct < 45 ? 'var(--water-mid)' : 'var(--water-deep)';

// Arco de 270°, de -135° a 135°, radio 90, centro (100,100).
const R = 90;
const CX = 100;
const CY = 100;
const START_ANGLE = -135;
const SWEEP = 270;

function punt(angleDeg) {
  const rad = (angleDeg * Math.PI) / 180;
  return { x: CX + R * Math.cos(rad), y: CY + R * Math.sin(rad) };
}
function arcPath(desde, fins) {
  const p1 = punt(desde);
  const p2 = punt(fins);
  const largeArc = fins - desde > 180 ? 1 : 0;
  return `M${p1.x},${p1.y} A${R},${R} 0 ${largeArc} 1 ${p2.x},${p2.y}`;
}

const finsPct = START_ANGLE + SWEEP * (pct / 100);
---
<div class="gauge" role="img" aria-label={percentatge === null ? 'Percentatge no disponible' : `${pct.toFixed(1)}% d'ompliment mitjà`}>
  <svg viewBox="0 0 200 200">
    <path d={arcPath(START_ANGLE, START_ANGLE + SWEEP)} fill="none" stroke="var(--line)" stroke-width="14" stroke-linecap="round" />
    {percentatge !== null && (
      <path d={arcPath(START_ANGLE, finsPct)} fill="none" stroke={color} stroke-width="14" stroke-linecap="round" />
    )}
  </svg>
  <div class="lectura">
    <span class="mono valor" style={`color:${color}`}>{percentatge !== null ? pct.toFixed(1) : '—'}</span>
    <span class="unitat">%</span>
  </div>
</div>

<style>
  .gauge {
    position: relative;
    width: 220px;
    max-width: 100%;
    aspect-ratio: 1;
    margin: 0 auto;
  }
  svg { width: 100%; height: 100%; }
  .lectura {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .valor { font-size: 3rem; line-height: 1; }
  .unitat { font-size: 1rem; color: var(--ink-soft); margin-top: 2px; }
</style>
