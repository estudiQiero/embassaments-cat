---
// Dial estilo cuentarrevoluciones para el % medio de ocupación de las
// conques internes: aguja marcadora + banda roja fija de peligro por
// debajo del llindar mínim, en lloc de l'arc de progrés pla d'abans.
interface Props {
  percentatge: number | null;
  llindarPerill?: number; // % per sota del qual es considera volum de reserva crític
}
const { percentatge, llindarPerill = 15 } = Astro.props;
const pct = percentatge === null ? 0 : Math.max(0, Math.min(100, percentatge));
const color = pct < llindarPerill ? 'var(--alert)' : pct < 45 ? 'var(--water-mid)' : 'var(--water-deep)';

// Arc de 270°, de 135° a 405° (el buit de 90° queda a la base,
// com un velocímetre clàssic), centre (100,100).
const CX = 100;
const CY = 100;
const START_ANGLE = 135;
const SWEEP = 270;
const R_TRACK = 78;
const TRACK_STROKE = 14;

function punt(angleDeg, radi) {
  const rad = (angleDeg * Math.PI) / 180;
  return { x: CX + radi * Math.cos(rad), y: CY + radi * Math.sin(rad) };
}
function arcPath(desde, fins, radi) {
  const p1 = punt(desde, radi);
  const p2 = punt(fins, radi);
  const largeArc = fins - desde > 180 ? 1 : 0;
  return `M${p1.x},${p1.y} A${radi},${radi} 0 ${largeArc} 1 ${p2.x},${p2.y}`;
}
function anglePct(p) {
  return START_ANGLE + SWEEP * (p / 100);
}

const anglePerill = anglePct(llindarPerill);
const angleAgulla = anglePct(pct);

// Marques cada 25%.
const MARQUES = [0, 25, 50, 75, 100];

// Agulla: punta cap al valor actual, amb una petita cua enrere per
// donar-li aspecte de vertadera agulla d'instrument.
const puntaAgulla = punt(angleAgulla, 84);
const cuaAgulla = punt(angleAgulla + 180, 14);
---
<div class="gauge" role="img" aria-label={percentatge === null ? 'Percentatge no disponible' : `${pct.toFixed(1)}% d'ompliment mitjà, llindar de perill al ${llindarPerill}%`}>
  <svg viewBox="-15 -15 230 230">
    <path d={arcPath(START_ANGLE, START_ANGLE + SWEEP, R_TRACK)} fill="none" stroke="var(--line)" stroke-width={TRACK_STROKE} stroke-linecap="round" />
    <path d={arcPath(START_ANGLE, anglePerill, R_TRACK)} fill="none" stroke="var(--alert)" stroke-width={TRACK_STROKE} stroke-linecap="round" />

    {MARQUES.map((m) => {
      const a = anglePct(m);
      const p1 = punt(a, R_TRACK + 10);
      const p2 = punt(a, R_TRACK + 18);
      return <line x1={p1.x} y1={p1.y} x2={p2.x} y2={p2.y} stroke="var(--ink-soft)" stroke-width="2" stroke-linecap="round" />;
    })}

    {percentatge !== null && (
      <g>
        <line x1={cuaAgulla.x} y1={cuaAgulla.y} x2={puntaAgulla.x} y2={puntaAgulla.y} stroke={color} stroke-width="4" stroke-linecap="round" />
        <circle cx={CX} cy={CY} r="9" fill="var(--surface-card)" stroke={color} stroke-width="3" />
      </g>
    )}
  </svg>
  <div class="lectura">
    <span class="mono valor" style={`color:${color}`}>{percentatge !== null ? pct.toFixed(1) : '—'}</span>
    <span class="unitat">%</span>
  </div>
</div>

<style>
  .gauge {
    width: 220px;
    max-width: 100%;
    margin: 0 auto;
  }
  svg { display: block; width: 100%; aspect-ratio: 1; }
  .lectura {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
    margin-top: -18px;
    background: var(--surface-dim);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 4px 14px;
    width: fit-content;
    margin-inline: auto;
  }
  .valor { font-size: 1.6rem; line-height: 1.4; }
  .unitat { font-size: 0.85rem; color: var(--ink-soft); }
</style>
